# Example: idempotent delete before recreate
TARGET_NAMES = {
    "Member Claims KPIs Dashboard",
    "Member Claims Utilization Dashboard",
    "member_claims_kpis_dashboard",
    "member_claims_utilization_dashboard",
}

found = find_dashboards_by_names(TARGET_NAMES)
print(f"Found {len(found)} matching dashboards.")
for d in found:
    print(f"  → {d.get('display_name')} ({d.get('dashboard_id')})")

for d in found:
    delete_dashboard(d["dashboard_id"])
    print(f"DELETED {d.get('display_name')}")
