# DBTITLE 1,Declarative Spec Processing (Three-Plane Architecture)
# ============================================================================
# When synthetic_data_spec.yaml is present, the template acts as a
# Deterministic Deployment Runtime: it reads the declarative spec,
# generates DataGenerator code from it, executes, and validates.
#
# The LLM produces ONLY the spec file. The template handles execution.
# This shrinks the LLM's executable surface area.
# ============================================================================

import hashlib as _hl
import json as _json

SPEC_PATH = "{{OUTPUT_FOLDER}}/synthetic_data_spec.yaml"

def validate_synthetic_spec(spec, table_spec_tables):
    """Validate the complete executable contract before generating/writing any table."""
    def require(condition, location, message):
        if not condition:
            raise RuntimeError(f"SYNTHETIC_SPEC_ERROR: {location}: {message}; no data writes started")
    require(isinstance(spec, dict), 'spec', 'expected a mapping')
    tables = spec.get('tables')
    require(isinstance(tables, list) and bool(tables), 'tables', 'expected a nonempty list')
    columns = {t['name']: {c['name'] for c in t['columns']} for t in table_spec_tables}
    require(all(isinstance(t, dict) and isinstance(t.get('name'), str) for t in tables),
            'tables', 'each entry requires a name')
    names = [t['name'] for t in tables]
    require(len(names) == len(set(names)) and set(names) == set(columns), 'tables', 'exact table inventory required')
    seen = set()
    for table in tables:
        name = table['name']
        require(type(table.get('rows')) is int and table['rows'] > 0, name+'.rows', 'positive integer required')
        pk = table.get('pk_columns')
        require(isinstance(pk, list) and all(isinstance(c, str) and c in columns[name] for c in pk),
                name+'.pk_columns', 'list of exact deployed columns required')
        domains = table.get('domain_columns')
        require(isinstance(domains, dict), name+'.domain_columns', 'mapping required, use {} when empty')
        for column, domain in domains.items():
            location = name+'.domain_columns.'+str(column)
            require(column in columns[name] and isinstance(domain, dict), location, 'unknown column or invalid domain')
            values, weights = domain.get('values'), domain.get('weights')
            require(isinstance(values, list) and bool(values) and isinstance(weights, list)
                    and len(values) == len(weights), location, 'nonempty equal-length values and weights required')
            require(all(type(w) in (int, float) and 0 <= w <= 1 for w in weights)
                    and abs(sum(weights)-1) < 1e-6, location, 'weights must be finite probabilities summing to 1')
        fks = table.get('fk_columns')
        require(isinstance(fks, dict), name+'.fk_columns', 'mapping required, use {} when empty')
        for column, fk in fks.items():
            location = name+'.fk_columns.'+str(column)
            require(column in columns[name] and isinstance(fk, dict), location, 'unknown child column or invalid mapping')
            require(set(fk) == {'parent_table', 'parent_pk'}, location,
                    'required keys are parent_table and parent_pk; aliases or inferred keys are not accepted')
            parent, key = fk['parent_table'], fk['parent_pk']
            require(isinstance(parent, str) and parent in columns, location+'.parent_table', 'unknown logical parent table')
            require(isinstance(key, str) and key in columns[parent], location+'.parent_pk', 'unknown parent key column')
            parent_entry = tables[names.index(parent)]
            require(key in parent_entry.get('pk_columns', []), location+'.parent_pk',
                    'referenced column must be included in the parent independently-unique generation columns (pk_columns); preserve the semantic primary key separately')
            require(parent in seen, location, 'parent must precede child; cycles/self references are unsupported')
        seen.add(name)
    return spec

if not os.path.exists(SPEC_PATH):
    raise RuntimeError("SYNTHETIC_SPEC_ERROR: synthetic_data_spec.yaml is required")
print(f"Reading declarative spec: {SPEC_PATH}")
SPEC = _load_yaml(SPEC_PATH)
validate_synthetic_spec(SPEC, TABLE_SPEC_TABLES)
spec_table_names = [table.get("name") for table in SPEC.get("tables", [])]
expected_table_names = [table["name"] for table in TABLE_SPEC_TABLES]
if (
    len(spec_table_names) != len(set(spec_table_names))
    or set(spec_table_names) != set(expected_table_names)
):
    raise RuntimeError(
        f"SYNTHETIC_SPEC_ERROR: exact table inventory mismatch; "
        f"expected {expected_table_names}, observed {spec_table_names}"
    )
print(f"  Tables in spec: {len(spec_table_names)}")

# Compute source hash for manifest
_spec_raw = _json.dumps(SPEC, sort_keys=True)
SOURCE_HASH = _hl.sha256(_spec_raw.encode()).hexdigest()
print(f"  Source hash: {SOURCE_HASH[:16]}...")

# COMMAND ----------

# DBTITLE 1,Generate Data from Declarative Spec (when available)
# ============================================================================
# Iterate over synthetic_data_spec.yaml in dependency order.
# For each table: validate domain cols, generate data, enforce limits, verify, write.
# ============================================================================

GENERATED_HASHES = []

if SPEC and SPEC.get("tables"):
    for table_entry in SPEC["tables"]:
        logical_name = table_entry["name"]
        if logical_name not in TABLES:
            raise RuntimeError(f"SYNTHETIC_SPEC_ERROR: unauthenticated table {logical_name}")
        actual_name = TABLES[logical_name]
        rows = table_entry.get("rows", 1000)
        pk_cols = table_entry.get("pk_columns", [])
        date_range = tuple(table_entry.get("date_range", ["2020-01-01", "2024-12-31"]))

        # Build domain_cols dict from spec
        DOMAIN_COLS = {}
        for col_name, col_spec in table_entry.get("domain_columns", {}).items():
            DOMAIN_COLS[col_name] = (col_spec["values"], col_spec["weights"])

        # Build fk_replacements dict from spec
        FK_REPLACEMENTS = {}
        for fk_col, fk_spec in table_entry.get("fk_columns", {}).items():
            parent_logical = fk_spec["parent_table"]
            if parent_logical not in TABLES:
                raise RuntimeError(
                    f"SYNTHETIC_SPEC_ERROR: unauthenticated parent table {parent_logical}"
                )
            parent_actual = TABLES[parent_logical]
            FK_REPLACEMENTS[fk_col] = (parent_actual, fk_spec["parent_pk"])

        separator = "=" * 60
        print(f"\n{separator}")
        print(f"Generating: {actual_name} ({rows} rows)")
        print(separator)

        # Gate 1: Validate domain cols against actual schema
        DOMAIN_COLS = validate_domain_cols(actual_name, DOMAIN_COLS)

        # Gate 2: Validate FK replacements against actual schema
        FK_REPLACEMENTS = validate_fk_replacements(actual_name, FK_REPLACEMENTS)

        # Generate data
        df = generate_table(
            actual_name, rows=rows,
            domain_cols=DOMAIN_COLS,
            pk_cols=pk_cols,
            fk_replacements=FK_REPLACEMENTS,
            date_range=date_range,
        )

        # Safety: enforce VARCHAR limits
        df = enforce_varchar_limits(df, actual_name)

        # Gate 3: Pre-write verification
        verify_before_write(
            df, actual_name,
            pk_cols=pk_cols,
            fk_cols=list(FK_REPLACEMENTS.keys()),
            categorical_cols=list(DOMAIN_COLS.keys()),
            domain_values={name: values for name, (values, weights) in DOMAIN_COLS.items()},
        )

        # Gate 4: Write to Delta table
        df.write.format("delta").mode("append").saveAsTable(f"{CATALOG}.{SCHEMA}.{actual_name}")
        print(f"  Written: {rows} rows to {CATALOG}.{SCHEMA}.{actual_name}")

        # Compute generated hash for this table
        _table_hash = _hl.sha256(str(actual_name).encode()).hexdigest()
        GENERATED_HASHES.append({"table": actual_name, "hash": _table_hash})

    # Re-read every schema after writes. Appends must not mutate the reconciled contract.
    post_write_inventory = []
    for table in TABLE_SPEC_TABLES:
        deployed_name = f"{table['name']}{ASSET_SUFFIX}"
        post_write_inventory.append({
            "table_fqn": f"{CATALOG}.{SCHEMA}.{deployed_name}",
            "schema": _read_schema(deployed_name),
        })
    if _canonical_sha256(post_write_inventory) != RECONCILIATION.get("observed_schema_sha256"):
        raise RuntimeError("SCHEMA_DRIFT_AFTER_DATA: deployed schema changed during generation")

    # Write manifest with hash chain
    _manifest = {
        "artifact_type": "synthetic_data",
        "run_id": RUN_ID,
        "asset_suffix": ASSET_SUFFIX,
        "validation_source": "template_runtime",
        "source_hash": SOURCE_HASH,
        "schema_reconciliation_path": RECONCILIATION_PATH,
        "schema_reconciliation_sha256": _raw_sha256(RECONCILIATION_PATH),
        "schema_readback_sha256": _canonical_sha256(post_write_inventory),
        "tables_generated": len(SPEC["tables"]),
        "table_hashes": GENERATED_HASHES,
        "state_comparison": "match",
    }
    _manifest_path = "{{OUTPUT_FOLDER}}/synthetic_data_manifest.json"
    if _manifest_path:
        _atomic_write_json(_manifest_path, _manifest)
        print(f"\nManifest written: {_manifest_path}")
        print(f"  Source hash:     {SOURCE_HASH[:16]}...")
        print(f"  Tables generated: {len(GENERATED_HASHES)}")
    print(f"\nSynthetic data generation complete from declarative spec.")

