# ────────────────────────────────────────────────────────────────────────────
#
# table_name = TABLES["fact_claim_header"]
#
# DOMAIN_COLS = {
#     "clm_claim_type": (["Professional", "Institutional", "Pharmacy"], [0.50, 0.35, 0.15]),
#     "clm_claim_status": (["Paid", "Denied", "Pending", "Adjusted"], [0.60, 0.15, 0.15, 0.10]),
#     "clm_line_of_business": (["Commercial", "Medicare", "Medicaid"], [0.50, 0.30, 0.20]),
# }
#
# FK_REPLACEMENTS = {
#     "clm_member_sk": (TABLES["dim_member"], "member_sk"),
#     "clm_provider_sk": (TABLES["dim_provider"], "provider_sk"),
# }
#
