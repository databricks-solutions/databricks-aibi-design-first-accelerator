# DBTITLE 1,Helpers — DATE vs TIMESTAMP formats
# DATE columns: format="%Y-%m-%d" ONLY (never %H:%M:%S on DATE)
# TIMESTAMP columns: format="%Y-%m-%d %H:%M:%S"
# Every column in DESCRIBE must appear in withColumn before FK wiring.
# See synthetic_data_generation.md

def sql_type_format(spark_type: str) -> str:
    t = (spark_type or "").upper()
    if t == "DATE":
        return "%Y-%m-%d"
    if "TIMESTAMP" in t:
        return "%Y-%m-%d %H:%M:%S"
    return None

