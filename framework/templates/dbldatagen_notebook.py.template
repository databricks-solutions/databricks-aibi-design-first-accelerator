# DBTITLE 1,Helper functions (COPY VERBATIM — do not remove)
# All columns MUST use add_column() — never inline withColumn for dates.


def column_format_from_spec(col: dict) -> str | None:
    """Resolve format from erd_parsed column; DATE/TIMESTAMP defaults are fixed."""
    if col.get("format"):
        return col["format"]
    t = (col.get("type") or "").upper()
    if t == "DATE":
        return DATE_FMT
    if "TIMESTAMP" in t:
        return TIMESTAMP_FMT
    return None


def validate_erd_date_formats(table_specs: list) -> None:
    """Fail fast before any DataGenerator runs."""
    errors = []
    for tbl in table_specs:
        tname = tbl.get("name", "?")
        for col in tbl.get("columns", []):
            t = (col.get("type") or "").upper()
            fmt = column_format_from_spec(col)
            cname = col.get("name", "?")
            if t == "DATE":
                if fmt != DATE_FMT:
                    errors.append(
                        f"{tname}.{cname}: type DATE requires format {DATE_FMT!r}, got {fmt!r}"
                    )
                if not col.get("format"):
                    errors.append(
                        f"{tname}.{cname}: add format: {DATE_FMT!r} to erd_parsed.yaml"
                    )
            if "TIMESTAMP" in t and fmt == DATE_FMT:
                errors.append(
                    f"{tname}.{cname}: TIMESTAMP cannot use date-only format {DATE_FMT!r}"
                )
    if errors:
        raise ValueError("erd_parsed.yaml date format errors:\n" + "\n".join(errors))


def add_column(gen, col: dict, fk_parent_df=None, fk_parent_key: str | None = None):
    """
    Add one column to dbldatagen DataGenerator. Branch on col['type'] — never reuse
    TIMESTAMP format for DATE columns.
    """
    import dbldatagen as dg

    name = col["name"]
    t = (col.get("type") or "").upper()
    gen_kind = (col.get("generator") or "").lower()
    fmt = column_format_from_spec(col)

    if gen_kind == "fk" or (fk_parent_df is not None and fk_parent_key):
        gen.withColumn(name, "long")
        if fk_parent_df is not None and fk_parent_key:
            gen.withForeignKey(
                fk_parent_df, parentKey=fk_parent_key, childKey=name, ratio=1.0
            )
        return gen

    if t == "DATE":
        # DATE only — never TIMESTAMP_FMT here
        gen.withColumn(
            name,
            "date",
            begin=datetime.date(2023, 1, 1),
            end=datetime.date(2025, 12, 31),
            format=DATE_FMT,
        )
        return gen

    if "TIMESTAMP" in t:
        gen.withColumn(
            name,
            "timestamp",
            begin="2023-01-01 00:00:00",
            end="2025-12-31 23:59:59",
            format=TIMESTAMP_FMT,
        )
        return gen

    if gen_kind in ("id",) or name.endswith("_sk") or name.endswith("_id"):
        gen.withColumn(name, "long", minValue=1, maxValue=10_000_000, unique=True)
        return gen

    if t in ("BIGINT", "LONG", "INT", "INTEGER"):
        gen.withColumn(name, "long", minValue=0, maxValue=1_000_000)
        return gen

    if t.startswith("DECIMAL") or t in ("DOUBLE", "FLOAT"):
        gen.withColumn(name, "float", minValue=0.0, maxValue=100000.0)
        return gen

    # STRING and default — line_of_business, codes, names, etc.
    gen.withColumn(name, "string", values=["A", "B", "C", "D", "E"])
    return gen


validate_erd_date_formats(tables)
print("✅ erd_parsed.yaml date formats validated")

