# DBTITLE 1,Setup and Utilities
import dbldatagen as dg
from pyspark.sql.types import *
from pyspark.sql import functions as F
from pyspark.sql.window import Window

# --- Safety: disable ANSI mode to prevent DIVIDE_BY_ZERO in dbldatagen ---
spark.conf.set("spark.sql.ansi.enabled", "false")

# IMPORTANT: Do NOT set any spark.databricks.delta.* configurations.
# They are NOT supported on serverless compute and will raise CONFIG_NOT_AVAILABLE.

# --- Safety patch: defense-in-depth for known dbldatagen issues ---
# These are SAFETY NETS only. The primary fixes are:
#   - GATE 5.2 (§5.4 in 01_create_data_layer.md): coerces types at YAML write time
#   - POST-BUILD type coercion in generate_table(): coerces at runtime
#   - generate_table() Tier 3: explicitly formats begin/end for timestamps
#
# This patch catches edge cases where custom code bypasses generate_table().
_orig_withColumn = dg.DataGenerator.withColumn

def _safe_withColumn(self, colName, colType, *args, **kwargs):
    """Intercept dbldatagen .withColumn() to fix known bugs.

    Bug 1 — BooleanType + values/weights: dbldatagen raises DATATYPE_MISMATCH
             when values=[True, False] is passed with BooleanType.
             Fix: strip values/weights; let dbldatagen generate random booleans.

    Bug 2 — TimestampType + date-only begin/end: dbldatagen raises ValueError
             when begin="2020-01-01" (needs "2020-01-01 00:00:00").
             Fix: auto-append time component to 10-char date strings.
    """
    # Bug 1: BooleanType cannot accept values/weights
    if isinstance(colType, BooleanType) or colType is BooleanType:
        kwargs.pop('values', None)
        kwargs.pop('weights', None)

    # Bug 2: TimestampType needs full datetime strings
    if isinstance(colType, TimestampType) or colType is TimestampType \
       or str(colType).lower() in ('timestamp', 'timestamp_ntz'):
        for key in ('begin', 'end'):
            val = kwargs.get(key)
            if isinstance(val, str) and len(val) == 10:
                kwargs[key] = f"{val} 00:00:00" if key == 'begin' else f"{val} 23:59:59"

    return _orig_withColumn(self, colName, colType, *args, **kwargs)

dg.DataGenerator.withColumn = _safe_withColumn

CATALOG = "{{SOURCE_CATALOG}}"
SCHEMA = "{{SOURCE_SCHEMA}}"
VERSION_SUFFIX = "{{VERSION_SUFFIX}}"

# ============================================================================
# UTILITY FUNCTIONS (domain-agnostic — DO NOT MODIFY)
# ============================================================================

def discover_tables() -> dict:
    """Discover all tables belonging to THIS version in the schema.
    Returns {logical_name: actual_table_name}."""
    all_tables = [row.tableName for row in spark.sql(f"SHOW TABLES IN `{CATALOG}`.`{SCHEMA}`").collect()]
    version_tables = [t for t in all_tables if t.endswith(VERSION_SUFFIX)] if VERSION_SUFFIX else all_tables
    result = {}
    for t in version_tables:
        logical = t[:-len(VERSION_SUFFIX)] if VERSION_SUFFIX else t
        result[logical] = t
    print(f"Discovered {len(result)} tables for version '{VERSION_SUFFIX}': {list(result.values())}")
    return result


def get_table_col_types(table_name: str) -> dict:
    """Read actual DDL column types from catalog. Returns {col_name: type_str}.
    Uses DESCRIBE TABLE to preserve VARCHAR(N) metadata."""
    rows = spark.sql(f"DESCRIBE TABLE `{CATALOG}`.`{SCHEMA}`.`{table_name}`").collect()
    result = {}
    for row in rows:
        col_name = row['col_name'].strip()
        data_type = row['data_type'].strip()
        if not col_name or col_name.startswith('#') or not data_type:
            break
        result[col_name] = data_type
    return result


def spark_type_for(type_str: str):
    """Map DDL type string to PySpark type."""
    t = type_str.lower().strip()
    if t in ('bigint', 'long'):
        return LongType()
    elif t in ('int', 'integer', 'smallint', 'tinyint'):
        return IntegerType()
    elif t == 'boolean':
        return BooleanType()
    elif t == 'date':
        return DateType()
    elif t in ('timestamp', 'timestamp_ntz'):
        return TimestampType()
    elif t in ('double', 'float'):
        return DoubleType()
    elif t.startswith('decimal'):
        return t  # pass as string for dbldatagen
    else:
        return StringType()


def extract_max_length(type_str: str) -> int:
    """Extract max length from VARCHAR(N) or CHAR(N). Returns 0 if unconstrained."""
    import re
    m = re.match(r'(?:var)?char\((\d+)\)', type_str.lower().strip())
    return int(m.group(1)) if m else 0


def enforce_varchar_limits(df, table_name: str):
    """Truncate ALL VARCHAR/CHAR columns to declared max length.
    Call AFTER build() and FK replacement, BEFORE write. Prevents
    DELTA_EXCEED_CHAR_VARCHAR_LIMIT regardless of how values were generated."""
    col_types = get_table_col_types(table_name)
    for col_name, type_str in col_types.items():
        max_len = extract_max_length(type_str)
        if max_len > 0 and col_name in df.columns:
            df = df.withColumn(col_name, F.substring(F.col(col_name).cast("string"), 1, max_len))
    return df


def verify_before_write(df, table_name: str, pk_cols: list, fk_cols: list, categorical_cols: list):
    """Pre-write verification. Call BEFORE .write to catch data issues early.
    Raises AssertionError with clear message if any check fails.

    Args:
        df: The DataFrame about to be written
        table_name: For error reporting
        pk_cols: Primary key columns (must be unique)
        fk_cols: Foreign key columns (must have diversity > 1)
        categorical_cols: Columns that should have domain values (no PLACEHOLDER/generic)
    """
    total = df.count()
    for pk in pk_cols:
        distinct = df.select(pk).distinct().count()
        assert distinct == total, f"[{table_name}] PK '{pk}' not unique: {distinct}/{total}"

    for fk in fk_cols:
        distinct = df.select(fk).distinct().count()
        assert distinct > 1, f"[{table_name}] FK '{fk}' has only {distinct} distinct value(s) — replacement not applied!"

    for col in categorical_cols:
        sample = [str(row[0]) for row in df.select(col).distinct().limit(10).collect()]
        bad_patterns = any(
            v.startswith("PLACEHOLDER") or v.startswith("ID-") or
            v.startswith("val_") or (len(v) > 8 and all(c in '0123456789' for c in v.replace('-', '')))
            for v in sample if v
        )
        assert not bad_patterns, (
            f"[{table_name}] Column '{col}' has generic values {sample[:5]} — "
            f"domain override was NOT applied! Must use domain-specific values."
        )


def validate_domain_cols(table_name: str, domain_cols: dict) -> dict:
    """DETERMINISM GATE: Validate domain_cols keys against actual table schema.

    Prevents the #1 synthetic data failure: LLM specifies domain values for
    column names that don't match the actual DDL (e.g., 'claim_type' when the
    actual column is 'clm_claim_type').

    This function:
    1. Runs DESCRIBE TABLE to get actual column names
    2. Attempts case-insensitive matching for each domain_col key
    3. RAISES AssertionError if any key has no match (forces LLM to fix)
    4. Returns a CORRECTED domain_cols dict with exact-case column names

    MUST be called BEFORE generate_table() for every table.
    """
    actual_cols = get_table_col_types(table_name)
    actual_lower_map = {c.lower(): c for c in actual_cols.keys()}

    corrected = {}
    unmatched = []

    for col_key, val in domain_cols.items():
        # Try exact match first, then case-insensitive
        if col_key in actual_cols:
            corrected[col_key] = val
        elif col_key.lower() in actual_lower_map:
            actual_name = actual_lower_map[col_key.lower()]
            corrected[actual_name] = val
            print(f"  ⚠️  Domain col '{col_key}' corrected to '{actual_name}'")
        else:
            unmatched.append(col_key)

    if unmatched:
        # Find closest matches for helpful error message
        available_strings = sorted(actual_cols.keys())
        raise AssertionError(
            f"[{table_name}] DOMAIN_COLS has {len(unmatched)} unmatched column(s): {unmatched}\n"
            f"  These columns do NOT exist in the table.\n"
            f"  Available columns ({len(actual_cols)}): {available_strings}\n"
            f"  FIX: Use exact column names from DESCRIBE TABLE."
        )

    print(f"  ✓ validate_domain_cols({table_name}): {len(corrected)} columns matched")
    return corrected


def validate_fk_replacements(table_name: str, fk_replacements: dict) -> dict:
    """Validate FK replacement keys exist in table schema.
    Returns corrected dict with exact-case column names."""
    if not fk_replacements:
        return {}

    actual_cols = get_table_col_types(table_name)
    actual_lower_map = {c.lower(): c for c in actual_cols.keys()}

    corrected = {}
    for fk_key, val in fk_replacements.items():
        if fk_key in actual_cols:
            corrected[fk_key] = val
        elif fk_key.lower() in actual_lower_map:
            actual_name = actual_lower_map[fk_key.lower()]
            corrected[actual_name] = val
            print(f"  ⚠️  FK col '{fk_key}' corrected to '{actual_name}'")
        else:
            print(f"  ⚠️  FK col '{fk_key}' not found in {table_name} — SKIPPED")

    return corrected


def generate_table(
    table_name: str,
    rows: int,
    domain_cols: dict,
    pk_cols: list = None,
    fk_replacements: dict = None,
    date_range: tuple = ("2020-01-01", "2024-12-31"),
) -> "DataFrame":
    """Generate a complete DataFrame for a table using the domain-first pattern.

    This is the RECOMMENDED generation function. It builds the DataGenerator in ONE pass:
    - Domain columns get explicit values/weights (no placeholder fallback)
    - Non-domain columns get type-appropriate random data via schema loop
    - FK columns are replaced with sampled parent keys after build()

    IMPORTANT: Call validate_domain_cols() BEFORE this function to ensure all
    domain_col keys match actual table columns. If you skip validation, unmatched
    columns are silently ignored and produce garbage data.

    Args:
        table_name: Actual table name in catalog (with version suffix)
        rows: Number of rows to generate
        domain_cols: Dict of {col_name: (values_list, weights_list)} for categorical columns.
                     Every analytical/categorical string column MUST be in this dict.
                     MUST be validated via validate_domain_cols() first.
        pk_cols: Primary key columns requiring uniqueness (default: [])
        fk_replacements: Dict of {fk_col: (parent_table, parent_pk_col)} for FK replacement.
                         After build(), FK columns are replaced with sampled parent keys.
                         MUST be validated via validate_fk_replacements() first.
        date_range: Tuple of (begin, end) date strings for date/timestamp columns.

    Returns:
        DataFrame ready for enforce_varchar_limits() + verify_before_write() + .write
    """
    col_types = get_table_col_types(table_name)
    pk_set = set(c.lower() for c in (pk_cols or []))
    fk_replacements = fk_replacements or {}
    fk_set = set(c.lower() for c in fk_replacements.keys())
    domain_set = set(c.lower() for c in domain_cols.keys())
    begin_date, end_date = date_range

    gen = dg.DataGenerator(spark, name=table_name, rows=rows, seedColumnName="_id")

    for col_name, type_str in col_types.items():
        col_lower = col_name.lower()
        ptype = spark_type_for(type_str)
        max_len = extract_max_length(type_str)
        is_pk = col_lower in pk_set

        # ── Tier 1: Domain columns (placeholder during build, values applied POST-BUILD) ──
        # NOTE: dbldatagen 'values' param is BROKEN on Spark Connect (produces literal
        # '{values[-1]}' instead of cycling through values). Domain values are applied
        # after build() using F.rand() + F.when() for weighted random assignment.
        if col_lower in domain_set:
            eff_len = min(max_len, 20) if max_len > 0 else 20
            gen = gen.withColumn(col_name, StringType(), template="\\w" * min(eff_len, 8), percentNulls=0.0)

        # ── Tier 2: FK columns (will be replaced after build — use placeholder int) ──
        elif col_lower in fk_set:
            if ptype == LongType() or ptype == IntegerType():
                gen = gen.withColumn(col_name, ptype, minValue=1, maxValue=rows, percentNulls=0.0)
            else:
                gen = gen.withColumn(col_name, StringType(), template="FK-\\n\\n\\n\\n", percentNulls=0.0)

        # ── Tier 3: Bulk non-domain columns (type-appropriate random data) ──
        elif ptype == LongType():
            gen = gen.withColumn(col_name, LongType(), minValue=1, maxValue=rows * 10,
                                uniqueValues=rows if is_pk else None, percentNulls=0.0)
        elif ptype == IntegerType():
            gen = gen.withColumn(col_name, IntegerType(), minValue=1,
                                maxValue=rows * 10 if is_pk else rows,
                                uniqueValues=rows if is_pk else None, percentNulls=0.0)
        elif ptype == DateType():
            gen = gen.withColumn(col_name, DateType(), begin=begin_date, end=end_date, percentNulls=0.0)
        elif ptype == TimestampType():
            gen = gen.withColumn(col_name, TimestampType(),
                                begin=f"{begin_date} 00:00:00", end=f"{end_date} 23:59:59", percentNulls=0.0)
        elif ptype == BooleanType():
            gen = gen.withColumn(col_name, BooleanType(), percentNulls=0.0)
        elif ptype == DoubleType():
            gen = gen.withColumn(col_name, DoubleType(), minValue=0.0,
                                maxValue=100000.0, percentNulls=0.0)
        elif isinstance(ptype, str) and 'decimal' in ptype:
            gen = gen.withColumn(col_name, ptype, minValue=0.0, maxValue=100000.0, percentNulls=0.0)
        else:
            # String column NOT in domain_cols — generate a short ID pattern
            eff_len = min(max_len, 20) if max_len > 0 else 20
            gen = gen.withColumn(col_name, StringType(),
                                template="\\w" * min(eff_len, 10),
                                uniqueValues=rows if is_pk else None, percentNulls=0.0)

    df = gen.build()

    # ── POST-BUILD: Apply domain values using F.rand() + F.when() ──
    # This replaces the broken dbldatagen 'values' param on Spark Connect.
    # Uses weighted random assignment based on cumulative probability thresholds.
    #
    # CRITICAL FIX — MIXED-TYPE COERCION (DETERMINISM RULE):
    # YAML auto-parses numeric-looking strings as integers (e.g., procedure code
    # '99213' becomes int 99213). When F.lit(99213) is written to a STRING column,
    # Spark throws NumberFormatException: "value 'D0120' cannot be cast to BIGINT"
    # because the column has mixed int+string values and Spark infers wrong type.
    #
    # FIX: Before building the F.when() chain, coerce ALL domain values to match
    # the target column's DDL type. String columns get str(v), timestamp columns
    # get datetime-formatted strings.
    #
    for dc_name_orig, (dc_values, dc_weights) in domain_cols.items():
        actual_col = next((c for c in col_types if c.lower() == dc_name_orig.lower()), None)
        if not actual_col or actual_col not in df.columns:
            continue

        # ── TYPE COERCION: match domain values to target DDL type ──
        target_type = col_types.get(actual_col, "string").lower()
        if any(t in target_type for t in ('char', 'string')):
            # STRING columns: force ALL values to str (fixes YAML int→str mismatch)
            dc_values = [str(v) for v in dc_values]
        elif 'timestamp' in target_type:
            # TIMESTAMP columns: ensure full datetime format (fixes date-only strings)
            coerced = []
            for v in dc_values:
                sv = str(v)
                if len(sv) == 10 and sv[4] == '-' and sv[7] == '-':  # YYYY-MM-DD
                    coerced.append(f"{sv} 00:00:00")
                else:
                    coerced.append(sv)
            dc_values = coerced
        elif 'date' in target_type and 'timestamp' not in target_type:
            # DATE columns: ensure YYYY-MM-DD format only
            dc_values = [str(v)[:10] for v in dc_values]
        elif any(t in target_type for t in ('bigint', 'long', 'int', 'integer')):
            # INTEGER columns: force to int (fixes YAML string→int mismatch)
            dc_values = [int(v) for v in dc_values]
        elif any(t in target_type for t in ('double', 'float', 'decimal')):
            # NUMERIC columns: force to float
            dc_values = [float(v) for v in dc_values]

        # Build cumulative weight thresholds
        cum_wts = []
        running = 0.0
        for wt in dc_weights:
            running += wt
            cum_wts.append(running)
        # Build CASE WHEN chain: rand() < threshold[i] => value[i]
        rand_col = F.rand(seed=hash(actual_col) % 10000)
        expr = F.lit(dc_values[-1])  # default = last value
        for i in range(len(dc_values) - 2, -1, -1):
            expr = F.when(rand_col <= cum_wts[i], F.lit(dc_values[i])).otherwise(expr)
        df = df.withColumn(actual_col, expr)

    # ── FK replacement: sample actual parent keys ──
    if fk_replacements:
        w = Window.orderBy(F.monotonically_increasing_id())
        df = df.withColumn("_row_num", F.row_number().over(w))
        for fk_col, (parent_table, parent_pk_col) in fk_replacements.items():
            parent_fqn = f"{CATALOG}.{SCHEMA}.{parent_table}"
            parent_pks = [row[0] for row in
                spark.table(parent_fqn).select(parent_pk_col).distinct().collect()]
            if parent_pks:
                # Cast to target type to avoid DELTA_METADATA_MISMATCH
                target_type = col_types.get(fk_col, "bigint").lower()
                replacement = F.element_at(
                    F.array([F.lit(v) for v in parent_pks]),
                    (F.col("_row_num") % len(parent_pks) + 1).cast("int")
                )
                if "bigint" in target_type or "long" in target_type:
                    replacement = replacement.cast(LongType())
                elif "int" in target_type:
                    replacement = replacement.cast(IntegerType())
                df = df.drop(fk_col).withColumn(fk_col, replacement)
        df = df.drop("_row_num")

    # ── PK uniqueness: ensure PK columns have sequential unique values ──
    if pk_cols:
        w = Window.orderBy(F.monotonically_increasing_id())
        df = df.withColumn("_pk_num", F.row_number().over(w))
        for pk_col in pk_cols:
            pk_type = spark_type_for(col_types.get(pk_col, "bigint"))
            if pk_type == LongType() or pk_type == IntegerType():
                df = df.drop(pk_col).withColumn(pk_col, F.col("_pk_num").cast(pk_type))
            else:
                # String PK — generate unique formatted IDs
                max_len = extract_max_length(col_types.get(pk_col, ""))
                prefix = table_name[:3].upper() + "-"
                pad_len = min(max_len - len(prefix), 10) if max_len > 0 else 10
                df = df.drop(pk_col).withColumn(pk_col,
                    F.concat(F.lit(prefix), F.lpad(F.col("_pk_num").cast("string"), pad_len, "0")))
        df = df.drop("_pk_num")

    # ── Reorder columns to match DDL schema (prevents DELTA_METADATA_MISMATCH) ──
    table_columns = list(col_types.keys())
    select_cols = [c for c in table_columns if c in df.columns]
    df = df.select(select_cols)

    return df


