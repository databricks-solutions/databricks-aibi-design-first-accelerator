# --- Safety: disable ANSI mode to prevent DIVIDE_BY_ZERO in dbldatagen ---
spark.conf.set("spark.sql.ansi.enabled", "false")

# IMPORTANT: Do NOT set any spark.databricks.delta.* configurations.
# They are NOT supported on serverless compute and will raise CONFIG_NOT_AVAILABLE.

# --- Safety patch: defense-in-depth for known dbldatagen issues ---
# These are SAFETY NETS only. The primary fixes are:
#   - GATE 5.2 in the authenticated v2 data-layer instructions validates YAML types
#   - POST-BUILD type coercion in generate_table(): coerces at runtime
#   - generate_table() Tier 3: explicitly formats begin/end for timestamps
#
# This patch catches edge cases where custom code bypasses generate_table().
_orig_withColumn = dg.DataGenerator.withColumn

def _safe_withColumn(self, colName, colType, *args, **kwargs):
    """Intercept dbldatagen .withColumn() to fix known bugs.

    Bug 1 — BooleanType + values/weights: dbldatagen raises DATATYPE_MISMATCH
             when values=[True, False] is passed with BooleanType.
             Fix: strip values/weights; let dbldatagen generate random booleans.

    Bug 2 — TimestampType + date-only begin/end: dbldatagen raises ValueError
             when begin="2020-01-01" (needs "2020-01-01 00:00:00").
             Fix: auto-append time component to 10-char date strings.
    """
    # Bug 1: BooleanType cannot accept values/weights
    if isinstance(colType, BooleanType) or colType is BooleanType:
        kwargs.pop('values', None)
        kwargs.pop('weights', None)

    # Bug 2: TimestampType needs full datetime strings
    if isinstance(colType, TimestampType) or colType is TimestampType \
       or str(colType).lower() in ('timestamp', 'timestamp_ntz'):
        for key in ('begin', 'end'):
            val = kwargs.get(key)
            if isinstance(val, str) and len(val) == 10:
                kwargs[key] = f"{val} 00:00:00" if key == 'begin' else f"{val} 23:59:59"

    return _orig_withColumn(self, colName, colType, *args, **kwargs)

dg.DataGenerator.withColumn = _safe_withColumn

OUTPUT_FOLDER = "{{OUTPUT_FOLDER}}"
CATALOG = "{{TARGET_CATALOG}}"
SCHEMA = "{{TARGET_SCHEMA}}"
ASSET_SUFFIX = "{{ASSET_SUFFIX}}"
VERSION_SUFFIX = ASSET_SUFFIX  # internal compatibility alias; never independently derived
TABLE_SPEC_PATH = f"{OUTPUT_FOLDER}/table_spec.yaml"
SCHEMA_ASSUMPTIONS_PATH = f"{OUTPUT_FOLDER}/schema_assumptions.yaml"
RECONCILIATION_PATH = f"{OUTPUT_FOLDER}/schema_reconciliation.yaml"
RUN_CONTEXT_PATH = f"{OUTPUT_FOLDER}/run_context.yaml"
HANDOFF_PATH = f"{OUTPUT_FOLDER}/step_handoff.yaml"
POLICY_ID = "DEPLOYED_DATATYPE_REPAIR_V1"
DATATYPE_RESOLUTION_POLICY_ID = "GREENFIELD_SYNTHETIC_DATATYPE_RESOLUTION_V1"


class _UniqueKeyLoader(yaml.SafeLoader):
    pass


def _construct_unique_mapping(loader, node, deep=False):
    mapping = {}
    for key_node, value_node in node.value:
        key = loader.construct_object(key_node, deep=deep)
        if key in mapping:
            raise ValueError(f"Duplicate YAML key: {key}")
        mapping[key] = loader.construct_object(value_node, deep=deep)
    return mapping


_UniqueKeyLoader.add_constructor(
    yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG,
    _construct_unique_mapping,
)


def _load_yaml(path):
    with open(path, encoding="utf-8") as handle:
        value = yaml.load(handle, Loader=_UniqueKeyLoader)
    if not isinstance(value, dict):
        raise RuntimeError(f"Expected a YAML mapping at {path}")
    return value


def _raw_sha256(path):
    with open(path, "rb") as handle:
        return hashlib.sha256(handle.read()).hexdigest()


def _atomic_write_json(path, value):
    temp_path = f"{path}.tmp.{os.getpid()}"
    with open(temp_path, "w", encoding="utf-8") as handle:
        json.dump(value, handle, indent=2, sort_keys=True)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temp_path, path)


def _canonical_sha256(value):
    payload = json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()


def _quote_identifier(value):
    if not isinstance(value, str) or not value or "`" in value:
        raise RuntimeError(f"Unsafe or empty SQL identifier: {value!r}")
    return f"`{value}`"


def _fqn(table):
    return ".".join(_quote_identifier(part) for part in (CATALOG, SCHEMA, table))


_TYPE_ALIASES = {"integer": "int", "long": "bigint"}
_SIMPLE_TYPES = {
    "bigint", "int", "smallint", "tinyint", "float", "double", "string",
    "boolean", "date", "timestamp", "timestamp_ntz", "binary",
}


def _canonicalize_datatype(value):
    if not isinstance(value, str) or not value.strip():
        raise RuntimeError("Empty deployed datatype")
    compact = re.sub(r"\s+", "", value).lower()
    compact = _TYPE_ALIASES.get(compact, compact)
    if compact in _SIMPLE_TYPES:
        return compact
    decimal_match = re.fullmatch(
        r"(decimal|dec|numeric)(?:\((\d+)(?:,(\d+))?\))?", compact
    )
    if decimal_match:
        precision = int(decimal_match.group(2) or 10)
        scale = int(decimal_match.group(3) or 0)
        if not 1 <= precision <= 38 or not 0 <= scale <= precision:
            raise RuntimeError(f"Invalid decimal bounds: {value}")
        return f"decimal({precision},{scale})"
    length_match = re.fullmatch(r"(varchar|char|nvarchar)\((\d+)\)", compact)
    if length_match and int(length_match.group(2)) > 0:
        return f"{length_match.group(1)}({int(length_match.group(2))})"
    raise RuntimeError(f"Unsupported or incomplete deployed datatype: {value}")


def _read_schema(table):
    rows = spark.sql(f"DESCRIBE TABLE {_fqn(table)}").collect()
    result = []
    for row in rows:
        column_name = str(row["col_name"]).strip()
        datatype = str(row["data_type"]).strip()
        if not column_name or column_name.startswith("#"):
            break
        result.append({
            "column": column_name,
            "datatype": datatype,
            "canonical_datatype": _canonicalize_datatype(datatype),
        })
    return result


def _expected_schema(table):
    return [
        {
            "column": column["name"],
            "datatype": column["type"].strip(),
            "canonical_datatype": _canonicalize_datatype(column["type"]),
        }
        for column in table["columns"]
    ]


# HARD PRE-DATA GATE: authenticate reconciliation evidence and refresh readback.
for _name, _value in {
    "OUTPUT_FOLDER": OUTPUT_FOLDER,
    "TARGET_CATALOG": CATALOG,
    "TARGET_SCHEMA": SCHEMA,
    "ASSET_SUFFIX": ASSET_SUFFIX,
}.items():
    if not _value or "{{" in _value or "}}" in _value:
        raise RuntimeError(f"Unresolved required template value: {_name}")

TABLE_SPEC = _load_yaml(TABLE_SPEC_PATH)
SCHEMA_ASSUMPTIONS = _load_yaml(SCHEMA_ASSUMPTIONS_PATH)
RECONCILIATION = _load_yaml(RECONCILIATION_PATH)
RUN_CONTEXT = _load_yaml(RUN_CONTEXT_PATH)
STEP_HANDOFF = _load_yaml(HANDOFF_PATH)
RUN_ID = RUN_CONTEXT.get("run_id")

if TABLE_SPEC.get("catalog") != CATALOG or TABLE_SPEC.get("schema") != SCHEMA:
    raise RuntimeError("SCHEMA_RECONCILIATION_AUTHORITY_ERROR: table_spec target mismatch")
table_spec_suffix = TABLE_SPEC.get("asset_suffix", TABLE_SPEC.get("version_suffix"))
if table_spec_suffix != ASSET_SUFFIX:
    raise RuntimeError("SCHEMA_RECONCILIATION_AUTHORITY_ERROR: table_spec asset_suffix mismatch")

parity_checks = {
    "context.target.catalog": (RUN_CONTEXT.get("target", {}).get("catalog"), CATALOG),
    "context.target.schema": (RUN_CONTEXT.get("target", {}).get("schema"), SCHEMA),
    "context.asset_suffix": (RUN_CONTEXT.get("version", {}).get("asset_suffix"), ASSET_SUFFIX),
    "context.output_folder": (RUN_CONTEXT.get("output_folder"), OUTPUT_FOLDER),
    "handoff.run_id": (STEP_HANDOFF.get("run_id"), RUN_ID),
    "handoff.catalog": (STEP_HANDOFF.get("catalog"), CATALOG),
    "handoff.schema": (STEP_HANDOFF.get("schema"), SCHEMA),
    "handoff.asset_suffix": (STEP_HANDOFF.get("asset_suffix"), ASSET_SUFFIX),
    "handoff.output_folder": (STEP_HANDOFF.get("output_folder"), OUTPUT_FOLDER),
    "reconciliation.run_id": (RECONCILIATION.get("run_id"), RUN_ID),
    "reconciliation.asset_suffix": (RECONCILIATION.get("asset_suffix"), ASSET_SUFFIX),
    "reconciliation.artifact_type": (
        RECONCILIATION.get("artifact_type"), "schema_reconciliation"
    ),
    "reconciliation.contract_version": (RECONCILIATION.get("contract_version"), 1),
    "reconciliation.producer_step": (
        RECONCILIATION.get("producer_step"), "create_data_layer"
    ),
    "reconciliation.producer_phase": (
        RECONCILIATION.get("producer_phase"), "reconcile_schema"
    ),
    "reconciliation.policy_id": (RECONCILIATION.get("policy_id"), POLICY_ID),
    "reconciliation.status": (RECONCILIATION.get("status"), "PASS"),
    "reconciliation.table_spec_sha256": (
        RECONCILIATION.get("table_spec_sha256"), _raw_sha256(TABLE_SPEC_PATH)
    ),
    "assumptions.run_id": (SCHEMA_ASSUMPTIONS.get("run_id"), RUN_ID),
    "assumptions.asset_suffix": (
        SCHEMA_ASSUMPTIONS.get("asset_suffix"), ASSET_SUFFIX
    ),
    "assumptions.catalog": (SCHEMA_ASSUMPTIONS.get("catalog"), CATALOG),
    "assumptions.schema": (SCHEMA_ASSUMPTIONS.get("schema"), SCHEMA),
    "assumptions.artifact_type": (
        SCHEMA_ASSUMPTIONS.get("artifact_type"), "schema_assumptions"
    ),
    "assumptions.contract_version": (
        SCHEMA_ASSUMPTIONS.get("contract_version"), 1
    ),
    "assumptions.policy_id": (
        SCHEMA_ASSUMPTIONS.get("policy_id"), DATATYPE_RESOLUTION_POLICY_ID
    ),
    "assumptions.status": (SCHEMA_ASSUMPTIONS.get("status"), "PASS"),
    "reconciliation.schema_assumptions_path": (
        RECONCILIATION.get("schema_assumptions_path"), SCHEMA_ASSUMPTIONS_PATH
    ),
    "reconciliation.schema_assumptions_sha256": (
        RECONCILIATION.get("schema_assumptions_sha256"),
        _raw_sha256(SCHEMA_ASSUMPTIONS_PATH),
    ),
    "reconciliation.datatype_resolution_policy_id": (
        RECONCILIATION.get("datatype_resolution_policy_id"),
        DATATYPE_RESOLUTION_POLICY_ID,
    ),
}
for field, (actual, expected) in parity_checks.items():
    if actual != expected:
        raise RuntimeError(
            f"SCHEMA_RECONCILIATION_AUTHORITY_ERROR: {field}={actual!r}, expected {expected!r}"
        )
# Backward compatibility for reconciliation evidence produced before these redundant
# location fields were added. The artifact is loaded only from the exact canonical sibling
# path, while table_spec, inventory FQNs, hashes, run/suffix, and fresh readback remain
# mandatory. A present conflicting value is never accepted.
legacy_optional_bindings = {
    "reconciliation.catalog": (RECONCILIATION.get("catalog"), CATALOG),
    "reconciliation.schema": (RECONCILIATION.get("schema"), SCHEMA),
    "reconciliation.output_folder": (RECONCILIATION.get("output_folder"), OUTPUT_FOLDER),
}
for field, (actual, expected) in legacy_optional_bindings.items():
    if actual is not None and actual != expected:
        raise RuntimeError(
            f"SCHEMA_RECONCILIATION_AUTHORITY_ERROR: {field}={actual!r}, expected {expected!r}"
        )
missing_legacy_bindings = sorted(
    field for field, (actual, _) in legacy_optional_bindings.items() if actual is None
)
if missing_legacy_bindings:
    print(
        "COMPATIBILITY: legacy schema_reconciliation location fields are absent: "
        f"{missing_legacy_bindings}; exact path plus run/suffix/table-spec/inventory/hash/"
        "readback bindings were required"
    )
if RECONCILIATION.get("unresolved_mismatches") != []:
    raise RuntimeError("SCHEMA_RECONCILIATION_AUTHORITY_ERROR: unresolved schema mismatches remain")
if SCHEMA_ASSUMPTIONS.get("unresolved_datatypes") != []:
    raise RuntimeError("SCHEMA_RECONCILIATION_AUTHORITY_ERROR: unresolved datatypes remain")
if SCHEMA_ASSUMPTIONS.get("resolution_count") != len(
    SCHEMA_ASSUMPTIONS.get("resolutions", [])
):
    raise RuntimeError("SCHEMA_RECONCILIATION_AUTHORITY_ERROR: assumptions count mismatch")

TABLE_SPEC_TABLES = TABLE_SPEC.get("tables")
if not isinstance(TABLE_SPEC_TABLES, list) or not TABLE_SPEC_TABLES:
    raise RuntimeError("SCHEMA_RECONCILIATION_AUTHORITY_ERROR: table_spec has no tables")

CURRENT_EXPECTED_INVENTORY = []
CURRENT_OBSERVED_INVENTORY = []
for table in TABLE_SPEC_TABLES:
    deployed_name = f"{table['name']}{ASSET_SUFFIX}"
    expected_schema = _expected_schema(table)
    observed_schema = _read_schema(deployed_name)
    if [x["column"] for x in expected_schema] != [x["column"] for x in observed_schema]:
        raise RuntimeError(f"SCHEMA_DRIFT_BEFORE_DATA: column mismatch in {deployed_name}")
    for expected_column, observed_column in zip(expected_schema, observed_schema):
        if expected_column["canonical_datatype"] != observed_column["canonical_datatype"]:
            raise RuntimeError(
                f"SCHEMA_DRIFT_BEFORE_DATA: {deployed_name}.{expected_column['column']} "
                f"expected {expected_column['datatype']}, observed {observed_column['datatype']}"
            )
    CURRENT_EXPECTED_INVENTORY.append({
        "table_fqn": f"{CATALOG}.{SCHEMA}.{deployed_name}", "schema": expected_schema
    })
    CURRENT_OBSERVED_INVENTORY.append({
        "table_fqn": f"{CATALOG}.{SCHEMA}.{deployed_name}", "schema": observed_schema
    })

if _canonical_sha256(CURRENT_EXPECTED_INVENTORY) != RECONCILIATION.get("expected_schema_sha256"):
    raise RuntimeError("SCHEMA_RECONCILIATION_AUTHORITY_ERROR: expected schema fingerprint mismatch")
if _canonical_sha256(CURRENT_OBSERVED_INVENTORY) != RECONCILIATION.get("observed_schema_sha256"):
    raise RuntimeError("SCHEMA_DRIFT_BEFORE_DATA: current readback fingerprint changed after reconciliation")
if RECONCILIATION.get("canonical_comparison") != "MATCH":
    raise RuntimeError("SCHEMA_RECONCILIATION_AUTHORITY_ERROR: canonical comparison is not MATCH")
if RECONCILIATION.get("expected_schema_inventory") != CURRENT_EXPECTED_INVENTORY:
    raise RuntimeError("SCHEMA_RECONCILIATION_AUTHORITY_ERROR: persisted expected inventory mismatch")
if RECONCILIATION.get("observed_schema_inventory") != CURRENT_OBSERVED_INVENTORY:
    raise RuntimeError("SCHEMA_RECONCILIATION_AUTHORITY_ERROR: persisted observed inventory mismatch")

# Full-notebook generation is append-only. Prove every target is still empty before
# either accepting a durable checkpoint or invoking the bounded lost-checkpoint recovery.
nonempty_targets = []
for table in TABLE_SPEC_TABLES:
    deployed_name = f"{table['name']}{ASSET_SUFFIX}"
    count = int(
        spark.sql(f"SELECT COUNT(*) AS row_count FROM {_fqn(deployed_name)}").collect()[0]["row_count"]
    )
    if count != 0:
        nonempty_targets.append({"table": deployed_name, "row_count": count})
if nonempty_targets:
    raise RuntimeError(
        f"SYNTHETIC_DATA_NONEMPTY_TARGET: refusing append-only rerun: {nonempty_targets}"
    )

# The standalone evidence is necessary but not sufficient: require its durable
# current-run phase record and both raw-artifact and live-readback fingerprints. A
# narrowly bounded recovery is allowed only when the record is absent (never when it
# exists but is invalid): the fully authenticated PASS artifact, its embedded exact
# inventories, a fresh exact DESCRIBE readback, and empty targets jointly reconstruct
# the complete phase record. Recovery atomically repairs and re-reads run_context.yaml
# before this notebook performs its first synthetic-data write.
phases_completed = RUN_CONTEXT.get("phases_completed")
if not isinstance(phases_completed, list) or any(
    not isinstance(record, dict) for record in phases_completed
):
    raise RuntimeError(
        "SCHEMA_RECONCILIATION_AUTHORITY_ERROR: phases_completed must be a list of mappings"
    )
phase_records = [
    record
    for record in phases_completed
    if record.get("step") == "create_data_layer"
    and record.get("phase") == "reconcile_schema"
]
artifact_sha256 = _raw_sha256(RECONCILIATION_PATH)
readback_sha256 = _canonical_sha256(CURRENT_OBSERVED_INVENTORY)
readback_locator = f"table_spec:{CATALOG}.{SCHEMA}:{ASSET_SUFFIX}"
expected_output_fingerprints = [
    {
        "id": "schema_reconciliation_artifact",
        "kind": "RAW_BYTES",
        "locator": RECONCILIATION_PATH,
        "sha256": artifact_sha256,
    },
    {
        "id": "schema_reconciliation_catalog_readback",
        "kind": "CATALOG_READBACK",
        "locator": readback_locator,
        "sha256": readback_sha256,
    },
]

if len(phase_records) == 0:
    greenfield = RUN_CONTEXT.get("data_source", {}).get("greenfield", {})
    downstream_records = [
        record for record in phases_completed
        if record.get("step") == "create_data_layer"
        and record.get("phase") in {"generate_synthetic_data", "validate_data"}
    ]
    if (
        RUN_CONTEXT.get("data_source", {}).get("type") not in {"erd", "erd_and_live_schema"}
        or greenfield.get("enabled") is not True
        or greenfield.get("synthetic_data") is not True
        or downstream_records
    ):
        raise RuntimeError(
            "SCHEMA_RECONCILIATION_AUTHORITY_ERROR: missing checkpoint is not eligible for "
            "greenfield lost-checkpoint recovery"
        )

    # Reconstruct the exact generic phase record only from the immutable checkpoint
    # envelope and evidence authenticated above. This is an atomic state repair, not
    # a substitute for schema reconciliation: any invalid existing record still halts.
    checkpointing = RUN_CONTEXT.get("checkpointing")
    if (
        not isinstance(checkpointing, dict)
        or checkpointing.get("contract_version") != 1
        or checkpointing.get("canonicalization") != "CANONICAL_JSON_UTF8_SHA256_V1"
    ):
        raise RuntimeError(
            "SCHEMA_RECONCILIATION_AUTHORITY_ERROR: checkpoint envelope is not recoverable"
        )
    frozen_recorded = checkpointing.get("frozen_run_contract_sha256")
    frozen_document = json.loads(json.dumps(RUN_CONTEXT))
    for mutable_key in (
        "current_step", "status", "phases_completed", "findings",
        "completed_at", "error", "retry_attempt",
    ):
        frozen_document.pop(mutable_key, None)
    frozen_document.get("checkpointing", {}).pop("frozen_run_contract_sha256", None)
    frozen_computed = _canonical_sha256(frozen_document)
    frozen_digest_repaired = False
    if frozen_recorded != frozen_computed:
        # Some legacy runs persisted the digest before the final immutable envelope was
        # serialized. Repair is safe only before any durable phase record exists and only
        # after every reconciliation, hash, inventory, fresh-readback, and empty-target
        # gate above has passed. An established checkpoint makes the digest immutable.
        if phases_completed:
            raise RuntimeError(
                "SCHEMA_RECONCILIATION_AUTHORITY_ERROR: frozen run contract mismatch "
                "with established phase records"
            )
        checkpointing["frozen_run_contract_sha256"] = frozen_computed
        frozen_recorded = frozen_computed
        frozen_digest_repaired = True
    producer_bundle = checkpointing.get("producer_bundles", {}).get("create_data_layer")
    producer_prompt = producer_bundle.get("prompt") if isinstance(producer_bundle, dict) else None
    if (
        not isinstance(producer_prompt, dict)
        or not producer_prompt.get("path")
        or not isinstance(producer_prompt.get("version"), int)
        or producer_prompt.get("version") < 1
        or not re.fullmatch(r"[0-9a-f]{64}", str(producer_prompt.get("sha256", "")))
        or not re.fullmatch(r"[0-9a-f]{64}", str(frozen_recorded or ""))
    ):
        raise RuntimeError(
            "SCHEMA_RECONCILIATION_AUTHORITY_ERROR: producer checkpoint authority is not recoverable"
        )

    catalog_identity = [item["table_fqn"] for item in CURRENT_EXPECTED_INVENTORY]
    recovered_record = {
        "step": "create_data_layer",
        "phase": "reconcile_schema",
        "checkpoint_contract_version": 1,
        "checkpoint_status": "VALID",
        "completed_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        "invalidated_at": None,
        "invalidation_reason": None,
        "producer_prompt_path": producer_prompt["path"],
        "producer_prompt_version": producer_prompt["version"],
        "producer_prompt_sha256": producer_prompt["sha256"],
        "producer_bundle_sha256": _canonical_sha256(producer_bundle),
        "frozen_run_contract_sha256": frozen_recorded,
        "input_fingerprints": sorted([
            {
                "id": "generate_ddl_catalog_identity",
                "kind": "CATALOG_READBACK",
                "locator": f"generated_tables:{CATALOG}.{SCHEMA}:{ASSET_SUFFIX}",
                "sha256": _canonical_sha256(catalog_identity),
            },
            {
                "id": "schema_assumptions_artifact",
                "kind": "RAW_BYTES",
                "locator": SCHEMA_ASSUMPTIONS_PATH,
                "sha256": _raw_sha256(SCHEMA_ASSUMPTIONS_PATH),
            },
            {
                "id": "table_spec_artifact",
                "kind": "RAW_BYTES",
                "locator": TABLE_SPEC_PATH,
                "sha256": _raw_sha256(TABLE_SPEC_PATH),
            },
        ], key=lambda item: item["id"]),
        "output_fingerprints": expected_output_fingerprints,
    }
    repaired_context = json.loads(json.dumps(RUN_CONTEXT))
    repaired_context["phases_completed"].append(recovered_record)
    _atomic_write_json(RUN_CONTEXT_PATH, repaired_context)
    RUN_CONTEXT = _load_yaml(RUN_CONTEXT_PATH)
    recovered_records = [
        record for record in RUN_CONTEXT.get("phases_completed", [])
        if isinstance(record, dict)
        and record.get("step") == "create_data_layer"
        and record.get("phase") == "reconcile_schema"
    ]
    if recovered_records != [recovered_record]:
        raise RuntimeError(
            "SCHEMA_RECONCILIATION_AUTHORITY_ERROR: recovered checkpoint readback mismatch"
        )
    output_fingerprints = recovered_record["output_fingerprints"]
    print(
        "CHECKPOINT_RECOVERY: atomically restored reconcile_schema from authenticated PASS "
        "evidence, exact fresh readback, and empty targets"
    )
    if frozen_digest_repaired:
        print(
            "CHECKPOINT_RECOVERY: repaired legacy frozen-run digest from the deterministic "
            "immutable run-context envelope before creating the first phase record"
        )
elif len(phase_records) > 1:
    raise RuntimeError(
        "SCHEMA_RECONCILIATION_AUTHORITY_ERROR: exactly one reconcile_schema phase record is required"
    )
else:
    phase_record = phase_records[0]
    if (
        phase_record.get("checkpoint_contract_version") != 1
        or phase_record.get("checkpoint_status") != "VALID"
        or not phase_record.get("completed_at")
        or phase_record.get("invalidated_at") is not None
        or phase_record.get("invalidation_reason") is not None
    ):
        raise RuntimeError(
            "SCHEMA_RECONCILIATION_AUTHORITY_ERROR: reconcile_schema phase record is not reusable"
        )
    output_fingerprints = phase_record.get("output_fingerprints")
    if not isinstance(output_fingerprints, list):
        raise RuntimeError(
            "SCHEMA_RECONCILIATION_AUTHORITY_ERROR: reconcile_schema output fingerprints are missing"
        )
artifact_fingerprint_ok = any(
    item.get("id") == "schema_reconciliation_artifact"
    and item.get("kind") == "RAW_BYTES"
    and item.get("locator") == RECONCILIATION_PATH
    and item.get("sha256") == artifact_sha256
    for item in output_fingerprints
    if isinstance(item, dict)
)
readback_fingerprint_ok = any(
    item.get("id") == "schema_reconciliation_catalog_readback"
    and item.get("kind") == "CATALOG_READBACK"
    and item.get("locator") == readback_locator
    and item.get("sha256") == readback_sha256
    for item in output_fingerprints
    if isinstance(item, dict)
)
if not artifact_fingerprint_ok or not readback_fingerprint_ok:
    raise RuntimeError(
        "SCHEMA_RECONCILIATION_AUTHORITY_ERROR: reconcile_schema phase fingerprints do not "
        "authenticate the persisted artifact and current catalog readback; "
        f"artifact_fingerprint_ok={artifact_fingerprint_ok}; "
        f"readback_fingerprint_ok={readback_fingerprint_ok}; "
        f"expected={expected_output_fingerprints!r}; observed={output_fingerprints!r}; "
        f"run_context_path={RUN_CONTEXT_PATH}. "
        "Do not rewrite reconciliation evidence or rerun append generation to repair a checkpoint."
    )

print(
    f"Schema reconciliation preflight PASSED: {len(TABLE_SPEC_TABLES)} exact empty targets; "
    "synthetic writes admitted"
)

