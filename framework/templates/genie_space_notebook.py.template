def validate_genie_config(
    table_identifiers: list,
    example_sqls: list,
    general_instructions: str,
    sample_questions: list,
) -> dict:
    """Deterministic validation of all LLM-generated Genie space content.

    Checks:
    1. All table_identifiers exist and are accessible
    2. All example SQL queries execute successfully
    3. Instructions reference actual column names (warning if suspicious)
    4. Sample questions are non-empty and distinct

    Returns: {status: PASS/FAIL, issues: [...], sql_results: [...]}
    """
    issues = []
    sql_results = []

    # 1. Validate table access
    print("Validating table identifiers...")
    for tbl in table_identifiers:
        try:
            spark.sql(f"DESCRIBE TABLE {tbl}").limit(1).collect()
            print(f"  \u2713 {tbl}")
        except Exception as e:
            issues.append(f"Table '{tbl}' not accessible: {e}")
            print(f"  \u2717 {tbl}: {e}")

    # 2. Validate example SQLs execute
    print("\nValidating example SQL queries...")
    for i, (question, sql) in enumerate(example_sqls, 1):
        try:
            result = spark.sql(f"SELECT * FROM ({sql}) _t LIMIT 1")
            cols = [f.name for f in result.schema.fields]
            sql_results.append({"idx": i, "question": question, "status": "PASS", "columns": cols})
            print(f"  \u2713 Q{i}: {question[:60]}... ({len(cols)} cols)")
        except Exception as e:
            issues.append(f"Example SQL #{i} failed: {question[:50]}... Error: {e}")
            sql_results.append({"idx": i, "question": question, "status": "FAIL", "error": str(e)})
            print(f"  \u2717 Q{i}: {question[:60]}... ERROR: {e}")

    # 3. Check sample questions
    if len(sample_questions) < 3:
        issues.append(f"Only {len(sample_questions)} sample questions (need >= 3)")
    if len(set(sample_questions)) != len(sample_questions):
        issues.append("Duplicate sample questions detected")

    # 4. Check instructions aren't empty/too short
    if len(general_instructions) < 100:
        issues.append(f"Instructions too short ({len(general_instructions)} chars) — need >= 100")

    status = "PASS" if not issues else "FAIL"
    print(f"\n{'\u2705' if status == 'PASS' else '\u274c'} Genie config validation: {status}")
    if issues:
        for issue in issues:
            print(f"   \u2022 {issue}")

    return {"status": status, "issues": issues, "sql_results": sql_results}


# Run validation
validation_result = validate_genie_config(
