# DBTITLE 1,Validate Space
# =============================================================================
# VALIDATE SPACE
# Read back the space config and display a summary.
# =============================================================================

target_id = SPACE_ID
if not target_id:
    print("No SPACE_ID set — set it in Cell 2 after creating a space.")
else:
    try:
        data = w.api_client.do(
            "GET",
            f"/api/2.0/genie/spaces/{target_id}",
            query={"include_serialized_space": "true"},
        )
        ss = json.loads(data["serialized_space"])

        sqs  = ss.get("config", {}).get("sample_questions", [])
        # NOTE: API stores metric_views under "tables" key in read-back
        mvs  = ss.get("data_sources", {}).get("metric_views", []) or \
               ss.get("data_sources", {}).get("tables", [])
        tis  = ss.get("instructions", {}).get("text_instructions", [])
        eqs  = ss.get("instructions", {}).get("example_question_sqls", [])
        bms  = ss.get("benchmarks", {}).get("questions", [])

        print("=" * 60)
        print("GENIE SPACE VALIDATION REPORT")
        print("=" * 60)
        print(f"Title        : {data.get('title')}")
        print(f"Space ID     : {data.get('space_id', target_id)}")
        print(f"Warehouse    : {data.get('warehouse_id', 'N/A')}")
        print(f"Description  : {data.get('description', '')[:120]}...")
        print()
        print(f"Metric Views        : {len(mvs)}")
        for mv in mvs:
            print(f"   • {mv['identifier'].split('.')[-1]}")
        print(f"Sample Questions    : {len(sqs)}")
        print(f"Example SQLs        : {len(eqs)}")
        print(f"Benchmark Questions : {len(bms)}")
        # Instructions are stored as multi-line arrays; join for total length
        instr_total = sum(len(''.join(t.get('content', []))) for t in tis)
        print(f"Text Instructions   : {len(tis)} block(s), {instr_total:,} chars")
        print()

        if bms:
            print("-" * 60)
            print("BENCHMARK QUESTIONS")
            print("-" * 60)
            for i, bm in enumerate(bms, 1):
                q = bm['question'][0]
                has_sql = bool(bm.get('answer'))
                marker = "\u2705" if has_sql else "\u26a0\ufe0f"
                print(f"  {i:2d}. {marker} {q}")

        # Completeness assertions (catch empty deployments)
        issues = []
        if len(sqs) < 5:
            issues.append(f"Only {len(sqs)} sample questions (need >= 5)")
        if len(eqs) < 5:
            issues.append(f"Only {len(eqs)} example SQLs (need >= 5)")
        if len(bms) < 3:
            issues.append(f"Only {len(bms)} benchmark questions (need >= 3)")
        if len(mvs) < 1:
            issues.append(f"No metric views configured (need >= 1)")
        # Instructions stored as multi-line array; join for length check
        instr_text = ''.join(tis[0].get('content', [])) if tis else ''
        if len(instr_text) < 100:
            issues.append(f"Instructions too short ({len(instr_text)} chars, need >= 100)")

        if issues:
            print("\n\u274c POST-DEPLOY VALIDATION FAILED:")
            for issue in issues:
                print(f"   \u2022 {issue}")
            raise AssertionError(
                f"Genie space deployed but INCOMPLETE. Fix config and re-run.\n"
                + "\n".join(f"  - {i}" for i in issues)
            )

        print()
        print("\u2705 Validation complete — all content checks passed")
    except Exception as e:
        if "AssertionError" in type(e).__name__:
            raise
        print(f"\u274c Failed to validate space: {e}")
        raise