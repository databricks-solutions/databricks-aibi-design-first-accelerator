def read_workspace_bytes(client, path):
    """Workspace paths are API locators, not guaranteed notebook-local mounts."""
    from databricks.sdk.errors import NotFound
    try:
        with client.workspace.download(path) as stream:
            return stream.read()
    except NotFound as exc:
        raise RuntimeError(
            f"METRIC_VIEW_INPUT_NOT_FOUND: {path}. Persist and verify the current-run "
            "spec before deployment; do not search other versions or create a placeholder."
        ) from exc


def write_workspace_bytes(client, path, payload):
    from databricks.sdk.service.workspace import ImportFormat
    client.workspace.mkdirs(posixpath.dirname(path))
    raw_format = getattr(ImportFormat, "RAW", None)
    if raw_format is not None:
        client.workspace.upload(path, payload, format=raw_format, overwrite=True)
    else:
        import base64
        client.api_client.do("POST", "/api/2.0/workspace/import", body={
            "path": path, "format": "RAW", "overwrite": True,
            "content": base64.b64encode(payload).decode("ascii"),
        })
    if read_workspace_bytes(client, path) != payload:
        raise RuntimeError(f'METRIC_VIEW_OUTPUT_READBACK_ERROR: {path}')

