        raise AssertionError(f"Verification FAILED: view {view_name} not found")

    # Check 2: MEASURE() smoke test
    first_measure = mv["yaml"]["measures"][0]["name"]
    try:
        smoke = execute_sql(f"SELECT MEASURE(`{first_measure}`) FROM {fqn} LIMIT 1")
        smoke_pass = True
        smoke_val = smoke.result.data_array[0][0] if smoke.result and smoke.result.data_array else None
        print(f"  {view_name}: MEASURE(`{first_measure}`) = {smoke_val} (PASS)")
    except RuntimeError as e:
        raise RuntimeError(f"Verification FAILED: {view_name} MEASURE() query: {e}") from e

    # Check 3: DESCRIBE for readback
    try:
        desc = execute_sql(f"DESCRIBE {fqn}")
        cols = []
        if desc.result and desc.result.data_array:
            for row in desc.result.data_array:
                if row[0] and not row[0].startswith("#"):
                    cols.append(row[0])
        definition = execute_sql(f"SHOW CREATE TABLE {fqn}")
        if not definition.result or not definition.result.data_array:
            raise RuntimeError(f"Verification FAILED: {view_name} has no definition readback")
        definition_text = definition.result.data_array[0][0]
        observed_yaml = verify_definition_readback(definition_text, mv['yaml'])
        READBACK_DATA.append({"view": view_name, "columns": sorted(cols), "yaml": observed_yaml})
    except RuntimeError as e:
        raise RuntimeError(f"Verification FAILED: {view_name} DESCRIBE: {e}") from e
    if not cols:
        raise RuntimeError(f"Verification FAILED: {view_name} returned no columns")

    VERIFICATION_RESULTS.append({
        "view": view_name, "exists": view_exists,
        "smoke_test": smoke_pass, "measure_tested": first_measure,
    })

readback_combined = json.dumps(READBACK_DATA, sort_keys=True)
READBACK_HASH = hashlib.sha256(readback_combined.encode()).hexdigest()
STATE_COMPARISON = "match" if DEPLOYED_VIEWS == [mv['name'] for mv in MV_SPECS] else "mismatch"
if STATE_COMPARISON != "match":
    raise RuntimeError('METRIC_VIEW_READBACK_ERROR: deployed inventory differs; canonical manifest blocked')

print(f"\nVerification: {len(VERIFICATION_RESULTS)} views verified")
print(f"Readback hash: {READBACK_HASH[:16]}...")
print(f"State comparison: {STATE_COMPARISON}")

# COMMAND ----------

# DBTITLE 1,Write Manifest
# =============================================================================
# MANIFEST: Immutable deployment evidence with hash chain
# source_hash -> generated_hash -> readback_hash -> state_comparison
# =============================================================================

manifest = {
    "artifact_type": "metric_views",
    "domain": "{{DOMAIN_NAME}}",
    "version_suffix": VERSION_SUFFIX,
    "validation_source": "catalog_readback",
    "evidence_type": "asset_locator_and_deployment_attempt",
    "artifact_id": hashlib.sha256((RUN_CONTEXT['run_id'] + SOURCE_HASH + READBACK_HASH).encode()).hexdigest(),
    "run_id": RUN_CONTEXT['run_id'],
    "asset_suffix": HANDOFF['asset_suffix'],
    **CAPABILITY_IDENTITY,
    "capability_contract_resolved_artifact": RESOLVED_CONTRACT_PATH,
    "metric_view_spec_sha256": SOURCE_HASH,
    "deployed_readback_sha256": READBACK_HASH,
    "validation_artifact": f"{OUTPUT_FOLDER}/metric_views/metric_view_validation.yaml",
    "source_hash": SOURCE_HASH,
    "generated_hash": GENERATED_HASH,
    "readback_hash": READBACK_HASH,
    "state_comparison": STATE_COMPARISON,
    "warehouse_id": WAREHOUSE_ID,
    "catalog": CATALOG,
    "schema": SCHEMA,
    "metric_views": [
        {
            "name": mv["name"],
            "fqn": f"{CATALOG}.{SCHEMA}.{mv['name']}",
            "sql_fqn": f"{CATALOG}.{SCHEMA}.{mv['name']}",
            "source_fqn": mv['yaml']['source'],
            "validation_status": "PASS",
            "source": mv["yaml"]["source"],
            "measure_count": len(mv["yaml"].get("measures", [])),
            "dimension_count": len(mv["yaml"].get("fields", [])),
            "join_count": len(mv["yaml"].get("joins", [])),
            "smoke_test": next(
                (v["smoke_test"] for v in VERIFICATION_RESULTS if v["view"] == mv["name"]), False
            ),
        }
        for mv in MV_SPECS
    ],
    "verification": VERIFICATION_RESULTS,
    "total_views": len(MV_SPECS),
    "total_views_deployed": len(DEPLOYED_VIEWS),
    "deploy_errors": DEPLOY_ERRORS,
}

manifest_path = f"{OUTPUT_FOLDER}/metric_views/metric_view_manifest.json"
write_workspace_bytes(w, manifest_path, json.dumps(manifest, indent=2).encode('utf-8'))

print(f"Manifest written: {manifest_path}")
