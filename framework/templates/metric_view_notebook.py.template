def validate_capability_inputs(context, handoff, plan, spec, contract_bytes, resolved_bytes):
    """Gate 0: authenticate pinned capability bytes and declared deployment decisions."""
    def require(ok, message):
        if not ok:
            raise RuntimeError('METRIC_VIEW_CAPABILITY_ERROR: ' + message)
    contract = yaml.safe_load(contract_bytes)
    digest = hashlib.sha256(contract_bytes).hexdigest()
    require(contract_bytes == resolved_bytes, 'resolved contract differs from frozen input')
    require(digest == context['inputs']['metric_view_capabilities']['sha256'], 'frozen contract digest mismatch')
    identity = contract['contract']
    require(contract.get('schema_version') == '1.0' and identity.get('status') == 'APPROVED', 'contract not approved/supported')
    target = contract['execution_target']
    require(target.get('type') == 'SQL_WAREHOUSE' and target.get('deployment_path') == 'STATEMENT_EXECUTION_API', 'incompatible execution target')
    require(context['run_id'] == plan.get('run_id'), 'plan run mismatch')
    require(handoff['asset_suffix'] == plan.get('asset_suffix') == context['version']['asset_suffix'], 'plan suffix mismatch')
    for key, expected in [('capability_contract_name', identity['name']),
                          ('capability_contract_version', identity['contract_version']),
                          ('capability_contract_sha256', digest)]:
        require(plan.get(key) == expected, key + ' mismatch')
    capabilities = contract['capabilities']
    for name, cap in capabilities.items():
        for field in ('platform_support', 'accelerator_validation', 'target_status'):
            require(cap.get(field) in contract['allowed_values'][field], name + ': invalid ' + field)
        require(type(cap.get('enabled')) is bool, name + ': enabled must be boolean')
    def native(name):
        cap = capabilities[name]
        return all(cap.get(k) == v for k, v in contract['resolution_policy']['native_enabled_when_all_are_true'].items())
    decisions = plan['metric_view_plan'].get('capability_decisions', [])
    require(isinstance(decisions, list) and decisions, 'missing capability decisions')
    seen = set()
    for decision in decisions:
        name = decision.get('required_capability')
        require(name in capabilities, 'unknown capability ' + str(name))
        key = (decision.get('kpi'), name)
        require(key[0] and key not in seen, 'missing or duplicate KPI/capability decision')
        seen.add(key)
        cap = capabilities[name]
        for field in ('platform_support', 'accelerator_validation', 'enabled', 'target_status'):
            require(decision.get(field) == cap[field], name + ': decision drift in ' + field)
        require(decision.get('native_outcome') == ('USED' if native(name) else 'DISALLOWED'), name + ': native decision mismatch')
        if decision.get('final_status') == 'READY' and not native(name):
            fallback = cap.get('fallback') or {}
            require(bool(fallback) and decision.get('fallback_considered') is True
                    and decision.get('fallback_strategy') == fallback.get('strategy')
                    and decision.get('fallback_outcome') == 'APPLIED_AND_VALIDATED', name + ': fallback not validated')
            checks = decision.get('fallback_checks', {})
            require(all(checks.get(k) == 'PASS' for k in fallback.get('required_checks', [])), name + ': missing fallback check evidence')
    planned = plan['metric_view_plan']['metric_views']
    require(all(type(v.get('primary')) is bool for v in planned)
            and sum(v['primary'] for v in planned) == 1, 'expected exactly one boolean primary')
    require([v['name'] for v in planned] == [v['name'] for v in spec['metric_views']], 'ordered plan/spec inventory mismatch')
    require(len({v['name'] for v in planned}) == len(planned), 'duplicate planned names')
    normalize = lambda value: value.replace('`', '').lower()
    handed = handoff['metric_view_fqns']
    require([(v['name'], normalize(v['sql_fqn']), v['primary']) for v in planned]
            == [(v['name'], normalize(v['sql_fqn']), v['primary']) for v in handed], 'handoff inventory mismatch')
    for entry, mv in zip(planned, spec['metric_views']):
        require(normalize(entry['sql_fqn']) == normalize(f"{handoff['catalog']}.{handoff['schema']}.{mv['name']}"), 'target mismatch')
        require(normalize(entry['source_fqn']) == normalize(mv['yaml']['source']), 'source mismatch')
        for kpi in entry['kpis']:
            rows = [d for d in decisions if d['kpi'] == kpi]
            require(rows and all(d['final_status'] == 'READY' for d in rows), 'deployed KPI lacks READY decisions: ' + kpi)
        yml = mv['yaml']
        require(str(yml['version']) == target['yaml_specification'], 'YAML version mismatch')
        # Enforce disabled constructs independently of the agent's decision rows.
        constructs = {'filter': 'metric_view_filter', 'parameters': 'parameters',
                      'materialization': 'metric_view_materialization'}
        for field, capability in constructs.items():
            if field in yml:
                require(capability in capabilities and native(capability), 'disabled construct: ' + field)
        require(native('yaml_specification_1_1') and native('table_or_view_source'), 'base capabilities disabled')
        for join in yml.get('joins', []):
            for field, capability in [('using', 'join_condition_using'), ('joins', 'nested_snowflake_joins')]:
                require(field not in join or native(capability), 'disabled join construct: ' + field)
        for measure in yml.get('measures', []):
            require('window' not in measure or native('window_measures_base'), 'disabled window measure')
    return {k: plan[k] for k in ('capability_contract_name', 'capability_contract_version', 'capability_contract_sha256')}


def verify_definition_readback(statement, expected):
    """Compare YAML semantics, ignoring serialization layout and numeric version spelling."""
    import re
    match = re.search(r'\bAS\s*\$\$(.*)\$\$\s*;?\s*$', statement, re.S | re.I)
    if not match:
        raise RuntimeError('METRIC_VIEW_READBACK_ERROR: SHOW CREATE returned no YAML body')
    observed = yaml.safe_load(match.group(1))
    expected = dict(expected)
    if isinstance(observed, dict):
        observed['version'] = str(observed.get('version'))
        expected['version'] = str(expected.get('version'))
    if observed != expected:
        raise RuntimeError('METRIC_VIEW_READBACK_ERROR: deployed YAML differs from intended spec')
    return observed


