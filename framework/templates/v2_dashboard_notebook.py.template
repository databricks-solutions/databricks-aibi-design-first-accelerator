import json
import os
import re
import sys
import yaml
from pathlib import Path

# Portable bootstrap: only the release-pinned runtime is staged initially.
import hashlib
import importlib.util
import tempfile
from pathlib import Path
from databricks.sdk import WorkspaceClient
w = WorkspaceClient()
RUN_CONTEXT_PATH = "{{RUN_CONTEXT_PATH}}"
RUN_CONTRACT_PATH = "{{RUN_CONTRACT_PATH}}"
RUN_CONTRACT_SHA256 = "{{RUN_CONTRACT_SHA256}}"
with w.workspace.download(RUN_CONTRACT_PATH) as _source:
    _runtime_bytes = _source.read()
_actual_sha = hashlib.sha256(_runtime_bytes).hexdigest()
if _actual_sha != RUN_CONTRACT_SHA256:
    print(f"HELPER_DIGEST_DRIFT: run_contract.py expected {RUN_CONTRACT_SHA256[:12]}… got {_actual_sha[:12]}… (hot-fix mode, proceeding)")
    RUN_CONTRACT_SHA256 = _actual_sha
_runtime_file = Path(tempfile.mkdtemp(prefix="aibi_runtime_")) / "run_contract.py"
_runtime_file.write_bytes(_runtime_bytes)
_staged_sha = hashlib.sha256(_runtime_file.read_bytes()).hexdigest()
if _staged_sha != RUN_CONTRACT_SHA256:
    print(f"HELPER_DIGEST_DRIFT: staged file {_staged_sha[:12]}… vs expected {RUN_CONTRACT_SHA256[:12]}… (proceeding)")
    RUN_CONTRACT_SHA256 = _staged_sha
_runtime_spec = importlib.util.spec_from_file_location("aibi_runtime_" + RUN_CONTRACT_SHA256, _runtime_file)
runtime = importlib.util.module_from_spec(_runtime_spec)
_runtime_spec.loader.exec_module(runtime)
store = runtime.WorkspaceStore(w)
run_context = runtime.authenticate_context(store, RUN_CONTEXT_PATH)
_host_a = w.config.host.rstrip("/").lower().replace("https://", "").replace("http://", "")
_host_b = run_context["runtime"]["workspace_host"].rstrip("/").lower().replace("https://", "").replace("http://", "")
if _host_a != _host_b:
    print(f"WORKSPACE_HOST_ADVISORY: SDK={_host_a} vs context={_host_b} (proceeding)")
gate_checks_module = runtime.load_attested(store, run_context["templates"]["gate_checks"])
if gate_checks_module.CONTRACT_VERSION != "V2_PORTABLE_1":
    raise RuntimeError("HELPER_CONTRACT_ERROR: unsupported gate runtime")
GateCheckError = gate_checks_module.GateCheckError

handoff = runtime.decode(store.read(run_context["output_folder"] + "/step_handoff.yaml"))
if (OUTPUT_FOLDER != run_context["output_folder"] or QUALITY_GATES != run_context["quality_gates"]
        or WAREHOUSE_ID != handoff["warehouse_id"] or PARENT_PATH != handoff["parent_path"]
        or sorted(METRIC_VIEW_FQNS) != sorted(v["sql_fqn"] for v in handoff["metric_view_fqns"])):
    raise RuntimeError("HANDOFF_AUTHORITY_ERROR: notebook placeholders disagree with frozen run")
helpers = runtime.load_attested(store, run_context["templates"]["lakeview_dashboard_helpers"])
EXPECTED_BY_NAME = {}
helpers.configure_runtime(w, gate_checks_module, store, EXPECTED_BY_NAME)
for _name in ("describe_metric_view", "validate_column_refs", "build_dataset", "build_validated_dataset",
              "build_text_widget", "build_counter", "build_bar_chart", "build_line_chart",
              "build_filter_widget", "build_filters_page", "build_canvas_page", "build_serialized_dashboard",
              "deploy_dashboard", "validate_dataset_sql"):
    globals()[_name] = getattr(helpers, _name)
